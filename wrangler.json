{
  "name": "sofiemyrbil-no-v0",
  "compatibility_date": "2026-10-24",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "main": "./lead-intake/examples/frontend-worker.mjs",
  "services": [
    {
      "binding": "INTAKE",
      "service": "sofiemyrbil-intake",
      "entrypoint": "IntakeService"
    }
  ],
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    },
    "traces": {
      "enabled": false
    }
  }
}
