{
  "name": "medon-integrated-astro-starter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "build": "astro build",
    "test": "node --test tests/*.test.mjs",
    "sync:choices": "node scripts/sync-page-options.mjs --pages src/content/pages --config .pages.yml --write",
    "check:choices": "node scripts/sync-page-options.mjs --pages src/content/pages --config .pages.yml --check",
    "verify": "npm run check:choices && npm test && npm run check && npm run build",
    "verify:second-brand": "node tests/second-brand-acceptance.mjs"
  },
  "dependencies": {
    "astro": "^7.3.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@tailwindcss/vite": "4.3.3",
    "daisyui": "5.7.50",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3",
    "yaml": "^2.8.1",
    "playwright": "^1.56.0"
  }
}
