{
  // Copy to wrangler.jsonc after provisioning a dedicated EU-jurisdiction D1.
  // This is deliberately disabled until the owner approves privacy + delivery.
  "name": "sofiemyrbil-intake",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-06",
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,
  "vars": {
    "SITE_ID": "sofiemyrbil.no",
    "INGRESS_ORIGIN": "https://sofiemyrbil-intake.anel.workers.dev",
    "ALLOWED_ORIGINS": "https://sofiemyrbil-no-v0.anel.workers.dev",
    "SITE_STAGE": "preview",
    "PRIVACY_APPROVED": "false",
    "PUBLIC_LEADS_ENABLED": "false",
    "SEND_NOTIFICATIONS": "false",
    "ACCESS_ISSUER": "",
    "ACCESS_AUD": ""
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "sofiemyrbil-leads",
    "database_id": "REPLACE_WITH_SOFiEMYRBIL_D1_ID",
    "migrations_dir": "migrations"
  }],
  "ratelimits": [{
    "name": "RATE_LIMITER",
    "namespace_id": "21373",
    "simple": {"limit": 10, "period": 60}
  }],
  "observability": {"enabled": false},
  "triggers": {"crons": ["* * * * *"]}
}
