---
/**
 * BookingForm – Interaktivt timebestillings- og henvendelsesskjema for Sofiemyr Bil AS
 * Inneholder de nøyaktige feltene låst med eier:
 * E-post *, Telefon *, Reg. nr. *, Tjenester (sjekkbokser) og Melding (textarea).
 */
interface Props { eyebrow?: string; heading?: string; intro?: string; }
const {
  eyebrow = 'Timebestilling & Prisforespørsel',
  heading = 'Bestill verkstedtime eller få prisoverslag',
  intro = 'Fyll ut feltene under, så kontakter en av våre bilmekanikere deg raskt for å bekrefte tidspunkt og pris.',
} = Astro.props;
const leadUrl = import.meta.env.PUBLIC_LEAD_ENDPOINT?.trim() ?? '';
const enabledByOwner = import.meta.env.PUBLIC_LEADS_ENABLED === 'true';
let endpointValid = false;
try {
  const url = new URL(leadUrl);
  endpointValid = url.protocol === 'https:' && url.pathname === '/api/leads' &&
    !url.username && !url.password && !url.search && !url.hash;
} catch { /* Preview remains disabled. */ }
const intakeConfigured = enabledByOwner && endpointValid;
---
<section id="bestilling-skjema" class="mws-booking-section">
  <div class="mws-booking-card">
    <div class="mws-booking-header">
      <span class="badge badge-primary">{eyebrow}</span>
      <h2>{heading}</h2>
      <p>{intro}</p>
    </div>

    <form class="mws-booking-form" id="mws-booking-form" method="post" action="/bestilling/" data-endpoint={intakeConfigured ? leadUrl : undefined}>
      <div class="mws-form-grid">
        <div class="form-control">
          <label class="label font-semibold" for="booking-regnr">
            <span>Registreringsnummer <span class="text-error">*</span></span>
          </label>
          <div class="mws-plate-input">
            <span class="mws-plate-flag" aria-hidden="true">N</span>
            <input
              id="booking-regnr"
              name="regnr"
              type="text"
              required
              maxlength="10"
              placeholder="F.eks. EK 12345"
              class="input input-bordered w-full font-mono uppercase font-bold tracking-wider"
              autocomplete="off"
            />
          </div>
          <span class="text-xs opacity-70 mt-1">Nødvendig for å finne riktig motortype, deler og kontrollfrist</span>
        </div>

        <div class="form-control">
          <label class="label font-semibold" for="booking-tlf">
            <span>Telefonnummer <span class="text-error">*</span></span>
          </label>
          <input
            id="booking-tlf"
            name="telefon"
            type="tel"
            required
            placeholder="F.eks. 900 00 000"
            class="input input-bordered w-full"
            autocomplete="tel"
          />
          <span class="text-xs opacity-70 mt-1">Vi ringer eller sender SMS for å bekrefte timen</span>
        </div>

        <div class="form-control col-span-full">
          <label class="label font-semibold" for="booking-epost">
            <span>E-postadresse <span class="text-error">*</span></span>
          </label>
          <input
            id="booking-epost"
            name="epost"
            type="email"
            required
            placeholder="navn@adresse.no"
            class="input input-bordered w-full"
            autocomplete="email"
          />
        </div>
      </div>

      <fieldset class="mws-services-fieldset">
        <legend class="font-semibold mb-2">Velg ønsket tjeneste (du kan velge flere):</legend>
        <div class="mws-checkbox-grid">
          <label class="mws-checkbox-item">
            <input type="checkbox" name="services" value="EU-Kontroll" class="checkbox checkbox-primary" />
            <span class="font-medium">EU-Kontroll <span class="text-xs opacity-75">(Fastpris kr 1 450,-)</span></span>
          </label>
          <label class="mws-checkbox-item">
            <input type="checkbox" name="services" value="Service" class="checkbox checkbox-primary" />
            <span class="font-medium">Service & Vedlikehold</span>
          </label>
          <label class="mws-checkbox-item">
            <input type="checkbox" name="services" value="Diagnose" class="checkbox checkbox-primary" />
            <span class="font-medium">Diagnose & Feilsøking</span>
          </label>
          <label class="mws-checkbox-item">
            <input type="checkbox" name="services" value="Dekkskifte" class="checkbox checkbox-primary" />
            <span class="font-medium">Dekkskifte & Hjulstilling</span>
          </label>
          <label class="mws-checkbox-item">
            <input type="checkbox" name="services" value="Reparasjon" class="checkbox checkbox-primary" />
            <span class="font-medium">Mekanisk Reparasjon</span>
          </label>
          <label class="mws-checkbox-item">
            <input type="checkbox" name="services" value="Karosseri" class="checkbox checkbox-primary" />
            <span class="font-medium">Karosseri & Rustkontroll</span>
          </label>
        </div>
      </fieldset>

      <div class="form-control mt-4">
        <label class="label font-semibold" for="booking-melding">
          <span>Melding / kommentar (valgfritt)</span>
        </label>
        <textarea
          id="booking-melding"
          name="melding"
          rows="4"
          placeholder="Beskriv eventuelle ulyder, ønsket dato for levering, eller spørsmål om arbeidet..."
          class="textarea textarea-bordered w-full"
        ></textarea>
      </div>

      <div class="hidden" aria-hidden="true">
        <label for="booking-confirmation">La dette feltet stå tomt</label>
        <input id="booking-confirmation" type="text" name="website_confirmation" autocomplete="off" tabindex="-1" />
      </div>
      <p class="text-sm mt-4">
        Opplysningene brukes for å behandle forespørselen din. Se <a href="/personvern/" class="link link-primary">personvernerklæringen</a>.
      </p>
      <div class="alert alert-warning mt-6" role="status" data-booking-unavailable hidden={intakeConfigured}>
        <span><strong>Innsending er ikke aktiv ennå.</strong> Skjemaet er under oppsett og sender ingen opplysninger. Ring verkstedet for å avtale time.</span>
      </div>
      <div class="mws-booking-actions">
        <button type="submit" class="btn btn-primary btn-lg w-full md:w-auto" data-booking-submit disabled>
          Send bestillingsforespørsel
        </button>
        <div class="mws-call-direct">
          <span>Eller ring oss direkte:</span>
          <a href="tel:+4766813700" class="btn btn-outline btn-md gap-2 font-bold">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            66 81 37 00
          </a>
        </div>
      </div>
      <div class="alert mt-4 hidden" role="status" aria-live="polite" data-booking-feedback></div>
    </form>
  </div>
</section>

<style>
  .mws-booking-section {
    padding: clamp(1rem, 3vw, 2.5rem) 0;
  }
  .mws-booking-card {
    background: var(--color-base-100);
    border: 1px solid var(--color-base-300);
    border-radius: var(--radius-box, 1rem);
    padding: clamp(1.5rem, 4vw, 3rem);
    box-shadow: 0 10px 30px color-mix(in srgb, var(--color-base-content) 6%, transparent);
    max-width: 52rem;
    margin-inline: auto;
  }
  .mws-booking-header {
    margin-bottom: 2rem;
    text-align: center;
  }
  .mws-booking-header h2 {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 700;
    margin: 0.75rem 0 0.5rem;
  }
  .mws-booking-header p {
    color: color-mix(in srgb, var(--color-base-content) 75%, transparent);
    max-width: 44ch;
    margin-inline: auto;
  }
  .mws-form-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: 1.25rem;
  }
  .mws-plate-input {
    display: flex;
    align-items: stretch;
    border-radius: var(--radius-field, 0.375rem);
    overflow: hidden;
  }
  .mws-plate-flag {
    display: flex;
    align-items: center;
    justify-content: center;
    background: #003399;
    color: white;
    font-weight: 900;
    font-size: 0.9rem;
    padding: 0 0.75rem;
    letter-spacing: 0.05em;
    user-select: none;
  }
  .mws-services-fieldset {
    margin-top: 1.75rem;
    padding: 1.25rem;
    border: 1px solid var(--color-base-300);
    border-radius: var(--radius-box, 0.75rem);
    background: var(--color-base-200);
  }
  .mws-checkbox-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 0.85rem;
  }
  .mws-checkbox-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    cursor: pointer;
    padding: 0.4rem;
    border-radius: var(--radius-field, 0.375rem);
  }
  .mws-checkbox-item:hover {
    background: color-mix(in srgb, var(--color-base-content) 4%, transparent);
  }
  .mws-booking-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-base-300);
  }
  .mws-call-direct {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.9rem;
  }
  @media(max-width: 640px) {
    .mws-call-direct {
      flex-direction: column;
      align-items: stretch;
      width: 100%;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLFormElement>('#mws-booking-form').forEach(form => {
    const endpoint = form.dataset.endpoint;
    const button = form.querySelector<HTMLButtonElement>('[data-booking-submit]');
    const feedback = form.querySelector<HTMLElement>('[data-booking-feedback]');
    if (!endpoint || !button || !feedback) return;
    button.disabled = false;
    let submitting = false;
    let submissionKey: string | undefined;
    form.addEventListener('input', () => { if (!submitting) submissionKey = undefined; });
    function status(text: string, isError: boolean) {
      feedback!.classList.remove('hidden', 'alert-success', 'alert-error');
      feedback!.classList.add(isError ? 'alert-error' : 'alert-success');
      feedback!.textContent = text;
    }
    form.addEventListener('submit', async event => {
      event.preventDefault();
      if (submitting || !form.reportValidity()) return;
      const fields = new FormData(form);
      const services = fields.getAll('services').map(String);
      if (services.length === 0) {
        status('Velg minst én tjeneste før du sender forespørselen.', true);
        return;
      }
      if (fields.get('website_confirmation')) return;
      const q = new URLSearchParams(location.search);
      const source: Record<string, string> = {page: location.pathname};
      for (const field of ['utm_source','utm_medium','utm_campaign','utm_content']) {
        const value = q.get(field);
        if (value) source[field] = value.slice(0, 120);
      }
      const payload = {
        site: 'sofiemyrbil.no', form: 'verksted-foresporsel',
        regnr: String(fields.get('regnr') ?? '').trim(),
        telefon: String(fields.get('telefon') ?? '').trim(),
        epost: String(fields.get('epost') ?? '').trim(),
        services, melding: String(fields.get('melding') ?? '').trim(), source,
        website_confirmation: String(fields.get('website_confirmation') ?? ''),
      };
      submissionKey ??= crypto.randomUUID().replaceAll('-', '');
      submitting = true;
      button.disabled = true;
      button.textContent = 'Sender forespørsel …';
      feedback.classList.add('hidden');
      const controller = new AbortController();
      const timer = setTimeout(() => controller.abort(), 12000);
      try {
        const response = await fetch(endpoint, {
          method: 'POST', mode: 'cors', credentials: 'omit', signal: controller.signal,
          headers: {'Content-Type': 'application/json', 'Idempotency-Key': submissionKey},
          body: JSON.stringify(payload),
        });
        const result = await response.json() as {ok?: boolean; id?: string; receipt_status?: string};
        if (!response.ok || result.ok !== true || typeof result.id !== 'string' || !result.id ||
            result.receipt_status !== 'stored') throw new Error('not-stored');
        status('Forespørselen din er registrert. Verkstedet kontakter deg for å bekrefte tidspunkt og pris. Referanse: ' + result.id, false);
        form.reset();
        button.textContent = 'Forespørsel registrert';
      } catch {
        status('Vi kunne ikke bekrefte registreringen. Prøv igjen, eller ring oss på 66 81 37 00.', true);
        button.disabled = false;
        button.textContent = 'Prøv innsending på nytt';
      } finally {
        clearTimeout(timer);
        submitting = false;
      }
    });
  });
</script>
