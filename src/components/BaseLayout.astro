---
import type { BuilderPage } from '../page-builder';
import { publicPath } from '../page-builder';
import { chrome } from '../lib/load-site';
import SiteChromeHeader from './SiteChromeHeader.astro';
import SiteChromeFooter from './SiteChromeFooter.astro';
import SiteChromeThemeHead from './SiteChromeThemeHead.astro';
import SiteChromeSearchHead from './SiteChromeSearchHead.astro';
import '../styles/global.css';
interface Props { page: BuilderPage; }
const { page } = Astro.props;
const canonical = new URL(publicPath(page.slug), Astro.site);
---
<!doctype html>
<html lang="nb">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex,nofollow" />
  <meta name="description" content={page.seo.description} />
  <link rel="canonical" href={canonical.href} />
  <title>{page.seo.title}</title>
  <SiteChromeThemeHead themes={chrome.themes} enabled={chrome.headerOptions.showThemeSwitch} />
  <SiteChromeSearchHead config={chrome} />
</head>
<body>
  <p class="mws-starter-warning">Teknisk demonstrasjon — ikke en publisert kundeside.</p>
  <SiteChromeHeader config={chrome} />
  <main id="main"><slot /></main>
  <SiteChromeFooter config={chrome} />
</body>
</html>
