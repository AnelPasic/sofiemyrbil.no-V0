---
import type { BuilderPage } from '../page-builder';
import { publicPath } from '../page-builder';
import { chrome } from '../lib/load-site';
import SiteChromeHeader from './SiteChromeHeader.astro';
import Attribution from '../../lead-intake/examples/Attribution.astro';
import SiteChromeFooter from './SiteChromeFooter.astro';
import SiteChromeThemeHead from './SiteChromeThemeHead.astro';
import SiteChromeSearchHead from './SiteChromeSearchHead.astro';
import '../styles/global.css';
interface Props { page: BuilderPage; }
const { page } = Astro.props;
const canonical = new URL(publicPath(page.slug), Astro.site);
---
<!doctype html>
<html lang="nb">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex,nofollow" />
  <meta name="description" content={page.seo.description} />
  <link rel="canonical" href={canonical.href} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400..800;1,400..800&display=swap" rel="stylesheet" />
  <title>{page.seo.title}</title>
  <SiteChromeThemeHead themes={chrome.themes} enabled={chrome.headerOptions.showThemeSwitch} />
  <SiteChromeSearchHead config={chrome} />
</head>
<body>
  <SiteChromeHeader config={chrome} />
  <main id="main" data-pagefind-body={page.slug !== '404' && page.slug !== 'design-system' ? '' : undefined} data-pagefind-ignore={page.slug === '404' || page.slug === 'design-system' ? '' : undefined}><slot /></main>
  <SiteChromeFooter config={chrome} />
  <Attribution />
  <!-- Retire the previous source-measurement choice cookie when the optional feature is off. -->
  <script is:inline>
    document.cookie = 'sofiemyr_attribution_permission=; Max-Age=0; Path=/; Secure; SameSite=Lax';
  </script>
</body>
</html>
