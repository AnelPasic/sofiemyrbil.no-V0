---
import type {SharedContent} from '../page-builder';
type Section=Pick<SharedContent,'id'|'heading'|'body'|'eyebrow'|'layout'|'surface'|'headingAlign'|'items'|'links'>;
interface Props {section:Partial<Section> & Pick<Section,'id'|'heading'>;}
const {section}=Astro.props;
const body=typeof section.body==='string'?(section.body?[section.body]:[]):(section.body??[]);
const layout=section.layout??'default',surface=section.surface??'default';
const bodyLayout=body.length>=2?layout:'default';
---
<section id={section.id} class="mws-rich-section" data-surface={surface} data-align={section.headingAlign??'center'}>
 {section.eyebrow&&<p class="eyebrow">{section.eyebrow}</p>}
 <h2>{section.heading}</h2>
 {body.length>0&&<div class="rich-paragraphs" data-layout={bodyLayout}>{body.map(text=><p>{text}</p>)}</div>}
 {section.items&&section.items.length>0&&<div class="rich-items" data-layout={layout}>
  {section.items.map((item,i)=><article class:list={['rich-card',item.boxVariant==='card'&&'elevated']} data-surface={item.surface??'default'}>
    <span aria-hidden="true">{String(i+1).padStart(2,'0')}</span>
    <h3>{item.title}</h3><p>{item.text}</p>
    {item.href&&<a href={item.href}>{item.label??item.title}</a>}
  </article>)}
 </div>}
 {section.links&&section.links.length>0&&<nav class="rich-links" aria-label={'Lenker: '+section.heading}>{section.links.map(link=><a href={link.href}>{link.label}</a>)}</nav>}
</section>
<style>
 .mws-rich-section{padding:clamp(2rem,4vw,3.5rem);border-radius:var(--radius-box,1rem);background:var(--color-base-100);}
 .mws-rich-section[data-surface="soft"]{background:var(--color-base-200);}
 .mws-rich-section[data-surface="mint"]{background:color-mix(in oklch,var(--color-success) 12%,var(--color-base-100));}
 .mws-rich-section[data-surface="lavender"]{background:color-mix(in oklch,var(--color-secondary) 12%,var(--color-base-100));}
 .mws-rich-section[data-surface="dark"]{background:var(--color-neutral);color:var(--color-neutral-content);}
 .mws-rich-section[data-align="center"]>h2,.mws-rich-section[data-align="center"]>.eyebrow{text-align:center;}
 h2{font-size:clamp(1.5rem,3vw,2.2rem);font-weight:700;}
 .eyebrow{font-size:.8rem;text-transform:uppercase;font-weight:700;letter-spacing:.07em;}
 .rich-paragraphs,.rich-items{display:grid;grid-template-columns:minmax(0,1fr);gap:clamp(1rem,2vw,2rem);margin-top:1.5rem;}
 .rich-paragraphs p{margin:0;line-height:1.65;white-space:pre-line;min-width:0;}
 .rich-card{background:var(--color-base-100);color:var(--color-base-content);border:1px solid var(--color-base-300);border-radius:var(--radius-box,1rem);min-width:0;padding:clamp(1rem,2vw,1.6rem);}
 .rich-card[data-surface="soft"]{background:var(--color-base-200);}
 .rich-card[data-surface="mint"]{background:color-mix(in oklch,var(--color-success) 12%,var(--color-base-100));}
 .rich-card[data-surface="lavender"]{background:color-mix(in oklch,var(--color-secondary) 12%,var(--color-base-100));}
 .rich-card[data-surface="dark"]{background:var(--color-neutral);color:var(--color-neutral-content);}
 .rich-card.elevated{box-shadow:0 12px 22px color-mix(in srgb,var(--color-base-content) 9%,transparent);}
 .rich-card h3{font-weight:700;font-size:1.1rem;margin:.6rem 0;}
 .rich-card p{white-space:pre-line;}
 .rich-links{display:flex;gap:1.3rem;flex-wrap:wrap;margin-top:1.5rem;}
 .rich-links a,.rich-card a{text-decoration:underline;text-underline-offset:3px;}
 @media(min-width:700px){
 .rich-paragraphs[data-layout="two-columns"],.rich-paragraphs[data-layout="three-columns"],.rich-items[data-layout="two-columns"],.rich-items[data-layout="three-columns"]{grid-template-columns:repeat(2,minmax(0,1fr));}
 }
 @media(min-width:1000px){.rich-paragraphs[data-layout="three-columns"],.rich-items[data-layout="three-columns"]{grid-template-columns:repeat(3,minmax(0,1fr));}}
</style>
