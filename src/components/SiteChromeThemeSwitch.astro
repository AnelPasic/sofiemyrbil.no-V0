---
import type { ChromeThemes } from '../lib/site-chrome-theme';
import { parseDaisyTheme } from '../lib/site-chrome-theme';
interface Props { themes: ChromeThemes; placement: 'desktop' | 'mobile'; }
const { themes, placement } = Astro.props;
// DaisyUI's theme-controller value is the CURRENT CMS dark theme, never a hardcoded preset.
const darkName = parseDaisyTheme(themes.darkCss, 'dark').name;
---
<label class:list={['mws-chrome-theme-switch', 'swap', 'swap-rotate',
  placement === 'mobile' ? 'mws-chrome-theme-switch--mobile' : 'mws-chrome-theme-switch--desktop']}
  title="Bytt fargetema">
  <input type="checkbox" class="theme-controller" value={darkName}
    data-mws-theme-toggle aria-label="Bytt til mørkt tema" />
  <svg class="swap-off" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"
    fill="currentColor" aria-hidden="true">
    <path d="M5.64 17l-.71.71a1 1 0 0 0 1.41 1.41l.71-.71A1 1 0 0 0 5.64 17ZM5 12a1 1 0 0 0-1-1H3a1 1 0 0 0 0 2h1a1 1 0 0 0 1-1Zm7-7a1 1 0 0 0 1-1V3a1 1 0 0 0-2 0v1a1 1 0 0 0 1 1ZM5.64 7.05a1 1 0 0 0 1.41 0 1 1 0 0 0 0-1.41l-.71-.71a1 1 0 0 0-1.41 1.41Zm12 .29a1 1 0 0 0 .7-.29l.71-.71a1 1 0 1 0-1.41-1.41L17 5.64a1 1 0 0 0 0 1.41c.2.2.45.29.66.29ZM21 11h-1a1 1 0 0 0 0 2h1a1 1 0 0 0 0-2Zm-9 8a1 1 0 0 0-1 1v1a1 1 0 0 0 2 0v-1a1 1 0 0 0-1-1Zm6.36-2a1 1 0 0 0-1.41 1.41l.71.71a1 1 0 0 0 1.41-1.41ZM12 6.5a5.5 5.5 0 1 0 0 11 5.5 5.5 0 0 0 0-11Zm0 9a3.5 3.5 0 1 1 0-7 3.5 3.5 0 0 1 0 7Z"/>
  </svg>
  <svg class="swap-on" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"
    fill="currentColor" aria-hidden="true">
    <path d="M21.64 13a1 1 0 0 0-1.05-.14 8.05 8.05 0 0 1-3.37.73A8.15 8.15 0 0 1 9.08 5.49a8.59 8.59 0 0 1 .25-2A1 1 0 0 0 8 2.36 10.14 10.14 0 1 0 22 14.05 1 1 0 0 0 21.64 13Zm-9.5 6.69A8.14 8.14 0 0 1 7.08 5.22v.27a10.15 10.15 0 0 0 10.14 10.14 9.79 9.79 0 0 0 2.1-.22 8.11 8.11 0 0 1-7.18 4.32Z"/>
  </svg>
</label>
